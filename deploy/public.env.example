# The public instance: reachable from the internet, so it needs a credential and a rate limit, and runs without the
# adapter factory (which spends teacher-model money and trains on the GPU).
# Copy it outside the repository, fill in the blanks, and keep it to yourself: it holds keys.
#   cp deploy/public.env.example ~/jeff-public.env && chmod 600 ~/jeff-public.env
#   deploy/run.sh ~/jeff-public.env       deploy/stop.sh ~/jeff-public.env
# A setting that is present but empty is refused, so fill in every blank line or delete it.

# --- deploy/run.sh ---
JEFF_SESSION_PREFIX=jeff-public           # tmux sessions jeff-public-engine-<gpu> and jeff-public-api
JEFF_GPUS=2,3                             # not the private instance's GPUs
JEFF_SOCKET_DIR=$HOME/jeff-public/sockets
JEFF_SERVED_FILE_DIR=$HOME/jeff-public/served
JEFF_ADAPTER_DIRS=$HOME/jeff-adapters
JEFF_BASE_VERSION=jeff-base@v1.3
# JEFF_START_ADAPTERS=spam                # first start only (no served file yet); unset: no adapter
# JEFF_BASE_FOLDER=$HOME/jeff-bases/v1.3-int4-gptq  # GPU engines only: serve this INT4 base (jeff runtime quantize)
                                          # instead of the bfloat16 one; refused unless its gate.json (jeff runtime
                                          # gate) passes for every adapter served. Unset: the bfloat16 base
JEFF_ENGINE_START_S=600
JEFF_API_START_S=60
JEFF_BATCH_WINDOW_MS=1
JEFF_MAX_BATCH_ROWS=64                    # rows of one micro-batch, every adapter's together; 64 is the largest pass a
                                          # GPU engine records (keep it small with JEFF_GPUS=mlx)
JEFF_QUEUE_LIMIT_ROWS=4096
JEFF_PREPARE_WORKERS=4                    # requests each engine prepares at once on arrival (checked, and on a GPU
                                          # tokenised), each by a thread with its own tokenizer; every engine, mlx too
JEFF_MAX_ADAPTERS=32                      # the most adapters each GPU engine holds at once (about 34 MB of GPU
                                          # memory each, allocated at start); leave it out with JEFF_GPUS=mlx
JEFF_PREFIX_POOL_MB=8192                  # each GPU engine's cache of prompt prefixes, allocated at start: holds 266
                                          # prefixes of 1,000 tokens, and must hold JEFF_MAX_BATCH_ROWS of 8,192 tokens
                                          # (7345 for 64); leave it out with JEFF_GPUS=mlx
JEFF_HOST=127.0.0.1                       # behind the reverse proxy, which sets X-Forwarded-For
JEFF_PORT=8796
JEFF_WORKERS=1                            # accounts mode counts usage in one process

# --- jeff-server serve (docs/operating.md, "Running the server") ---
JEFF_PUBLIC=1
JEFF_RATE_LIMIT=20/8                      # per caller and per worker: <requests per second>/<concurrent requests>
JEFF_MODEL_NAME=jeff-v1.3
JEFF_HUB_PUBLIC_KEY=$HOME/jeff-public/hub-public.pem   # callers bring hub-signed tokens
JEFF_API_KEY=                             # the owner's key
JEFF_ACCESS_LOG=$HOME/jeff-public/access.log
# No JEFF_FACTORY or other factory setting: a public server refuses them.

# --- accounts mode (docs/release/accounts-go-live.md): keys made on jeffhub.ai, usage counted here ---
JEFF_ACCOUNTS_URL=https://jeffhub.ai                        # the hub's internal API (GET keys, POST usage)
JEFF_ACCOUNTS_TOKEN_FILE=$HOME/jeff-public/accounts-token   # the shared secret, chmod 600, outside every repo
JEFF_ACCOUNTS_MAX_STALE_SECONDS=600                         # refuse account keys when the key list is older
JEFF_USAGE_FILE=$HOME/jeff-public/usage.jsonl               # the usage counters, kept across restarts
# Adapters that must be private (deploy/README.md, "Private adapters"): the server refuses to start, or to rebuild its
# catalogue, when one of them is missing or its manifest has no access line, or when an adapter whose manifest has an
# access line is not listed: the list and the manifests must agree exactly. Required in accounts mode.
JEFF_PRIVATE_ADAPTERS=                    # the IDs, comma-separated; the owner's list: deploy/private-adapters.txt
# JEFF_ACCOUNTS_BYPASS_FILE=$HOME/jeff-public/accounts-bypass # optional: Vercel's protection-bypass secret for a
                                                              # JEFF_ACCOUNTS_URL behind Vercel Deployment Protection;
                                                              # chmod 600, outside every repo; unset: no header sent
