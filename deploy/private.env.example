# The private instance: the owner's server, with the console, the access log and the adapter factory.
# Copy it outside the repository, fill in the blanks, and keep it to yourself: it holds keys.
#   cp deploy/private.env.example ~/jeff-private.env && chmod 600 ~/jeff-private.env
#   deploy/run.sh ~/jeff-private.env      deploy/stop.sh ~/jeff-private.env
# A setting that is present but empty is refused, so fill in every blank line or delete it.

# --- deploy/run.sh ---
JEFF_SESSION_PREFIX=jeff-private          # tmux sessions jeff-private-engine-<gpu>, -api, -factory
JEFF_GPUS=0,1                             # one engine per GPU index; mlx on a Mac
JEFF_SOCKET_DIR=$HOME/jeff-private/sockets          # engine-<gpu>.sock (create the folder first)
JEFF_SERVED_FILE_DIR=$HOME/jeff-private/served      # served-<gpu>.json: what each engine served last
JEFF_ADAPTER_DIRS=$HOME/jeff-adapters     # folders of adapter folders, ':' between them; the API and the factory
                                          # read it too, and the factory publishes into the first one
JEFF_BASE_VERSION=jeff-base@v1.3
# JEFF_START_ADAPTERS=spam,jeff.legal.legal-clauses   # first start only (no served file yet); unset: no adapter
# JEFF_BASE_FOLDER=$HOME/jeff-bases/v1.3-int4-gptq  # GPU engines only: serve this INT4 base (jeff runtime quantize)
                                          # instead of the bfloat16 one; refused unless its gate.json (jeff runtime
                                          # gate) passes for every adapter served. Unset: the bfloat16 base
JEFF_ENGINE_START_S=600                   # how long each engine may take to load before run.sh gives up
JEFF_API_START_S=60                       # how long the API may take to answer /health before run.sh gives up
JEFF_BATCH_WINDOW_MS=1
JEFF_MAX_BATCH_ROWS=64                    # rows of one micro-batch, every adapter's together; 64 is the largest pass a
                                          # GPU engine records (keep it small with JEFF_GPUS=mlx)
JEFF_QUEUE_LIMIT_ROWS=4096
JEFF_PREPARE_WORKERS=4                    # requests each engine prepares at once on arrival (checked, and on a GPU
                                          # tokenised), each by a thread with its own tokenizer; every engine, mlx too
JEFF_MAX_ADAPTERS=32                      # the most adapters each GPU engine holds at once (about 34 MB of GPU
                                          # memory each, allocated at start); leave it out with JEFF_GPUS=mlx
JEFF_PREFIX_POOL_MB=8192                  # each GPU engine's cache of prompt prefixes, allocated at start: holds 266
                                          # prefixes of 1,000 tokens, and must hold JEFF_MAX_BATCH_ROWS of 8,192 tokens
                                          # (7345 for 64); leave it out with JEFF_GPUS=mlx
JEFF_HOST=127.0.0.1                       # behind the reverse proxy
JEFF_PORT=8795
JEFF_WORKERS=2

# --- jeff-server serve (docs/operating.md, "Running the server") ---
JEFF_MODEL_NAME=jeff-v1.3
JEFF_API_KEY=                             # the owner's key
JEFF_UI_USERS=$HOME/jeff-private/ui-users.json      # console logins: jeff-server users <file> add <login>
JEFF_ADMINS=                              # logins that may read the access log, comma-separated
JEFF_ACCESS_LOG=$HOME/jeff-private/access.log

# --- the adapter factory (API and jeff-server factory worker) ---
JEFF_FACTORY=owner
JEFF_FACTORY_DIR=$HOME/jeff-private/factory         # on a local disk: the job queue is locked with flock
JEFF_TEACHER_URL=                         # an OpenAI-compatible base URL
JEFF_TEACHER_KEY=
JEFF_TEACHER_MODEL=
JEFF_TRAINER=$HOME/jeff-trainer           # the pinned trainer install: .venv/bin/jeff-train and TRAINER_COMMIT
JEFF_FACTORY_MIN_FREE_GB=20
JEFF_FACTORY_GPU=1                        # the one GPU the factory worker trains on (its CUDA_VISIBLE_DEVICES); it
                                          # may be an engine's, with JEFF_FACTORY_MIN_FREE_GB free; mlx on a Mac
