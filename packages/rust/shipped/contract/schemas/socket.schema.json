{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jeff.dev/schemas/socket.schema.json",
  "title": "Jeff engine socket message",
  "description": "Every message of the engine socket and of the channel (contract/socket.md). The engine socket answers the channel-only operations (auth, refresh, bind, call, call_many, release, decide, dispatch, graph) with InvalidRequest, and the channel answers the engine-only ones (installed, reload, stats, health, predict, serve) the same way.",
  "$defs": {
    "id": {"type": "integer", "minimum": 1},
    "handle": {"type": "integer", "minimum": 1},
    "hello": {"type": "object", "additionalProperties": false, "required": ["op", "version"],
              "properties": {"op": {"const": "hello"}, "version": {"type": "integer"}}},
    "engine_hello": {"type": "object", "additionalProperties": false, "required": ["op", "version", "adapters_version"],
                     "properties": {"op": {"const": "hello"}, "version": {"type": "integer"},
                                    "adapters_version": {"type": "integer", "minimum": 0}}},
    "predict": {"type": "object", "additionalProperties": false, "required": ["op", "id", "adapter", "rows"],
                "properties": {"op": {"const": "predict"}, "id": {"$ref": "#/$defs/id"}, "adapter": {"type": "string", "minLength": 1},
                               "rows": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "object"}},
                               "deadline_ms": {"type": "number", "exclusiveMinimum": 0}}},
    "serve": {"type": "object", "additionalProperties": false, "required": ["op", "id", "adapters"],
              "properties": {"op": {"const": "serve"}, "id": {"$ref": "#/$defs/id"},
                             "adapters": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "ok_reply": {"type": "object", "additionalProperties": false, "required": ["id", "ok", "result"],
                 "properties": {"id": {"type": "integer", "minimum": 0}, "ok": {"const": true}, "result": {"type": "object"}}},
    "failure_reply": {"type": "object", "additionalProperties": false, "required": ["id", "ok", "error"],
                      "properties": {"id": {"type": "integer", "minimum": 0}, "ok": {"const": false},
                                     "error": {"type": "object", "additionalProperties": false, "required": ["type", "message", "details"],
                                               "properties": {"type": {"type": "string"}, "message": {"type": "string"},
                                                              "details": {"type": "object"}}}}},
    "simple": {"type": "object", "additionalProperties": false, "required": ["op", "id"],
               "properties": {"op": {"enum": ["installed", "reload", "stats", "health"]}, "id": {"$ref": "#/$defs/id"}}},
    "auth": {"type": "object", "additionalProperties": false, "required": ["op", "id", "token"],
             "properties": {"op": {"enum": ["auth", "refresh"]}, "id": {"$ref": "#/$defs/id"},
                            "token": {"type": "string", "minLength": 1}}},
    "bind": {"type": "object", "additionalProperties": false, "required": ["op", "id", "function"],
             "properties": {"op": {"const": "bind"}, "id": {"$ref": "#/$defs/id"},
                            "function": {"type": "string", "minLength": 1},
                            "context": {"$ref": "https://jeff.dev/schemas/decide_request.schema.json#/$defs/context"},
                            "labels": {"$ref": "https://jeff.dev/schemas/decide_request.schema.json#/$defs/labels"},
                            "on_low_confidence": {"$ref": "https://jeff.dev/schemas/decide_request.schema.json#/$defs/policy"}}},
    "call": {"type": "object", "additionalProperties": false, "required": ["op", "id", "handle", "input"],
             "properties": {"op": {"const": "call"}, "id": {"$ref": "#/$defs/id"}, "handle": {"$ref": "#/$defs/handle"},
                            "input": true}},
    "call_many": {"type": "object", "additionalProperties": false, "required": ["op", "id", "handle", "inputs"],
                  "properties": {"op": {"const": "call_many"}, "id": {"$ref": "#/$defs/id"},
                                 "handle": {"$ref": "#/$defs/handle"},
                                 "inputs": {"type": "array", "minItems": 1, "maxItems": 256}}},
    "release": {"type": "object", "additionalProperties": false, "required": ["op", "id", "handle"],
                "properties": {"op": {"const": "release"}, "id": {"$ref": "#/$defs/id"},
                               "handle": {"$ref": "#/$defs/handle"}}},
    "decide": {"type": "object", "additionalProperties": false, "required": ["op", "id", "calls"],
               "properties": {"op": {"const": "decide"}, "id": {"$ref": "#/$defs/id"},
                              "calls": {"type": "array", "minItems": 1, "maxItems": 256,
                                        "items": {"$ref": "https://jeff.dev/schemas/decide_request.schema.json#/$defs/call"}},
                              "on_low_confidence": {"$ref": "https://jeff.dev/schemas/decide_request.schema.json#/$defs/policy"}}},
    "dispatch": {"type": "object", "additionalProperties": false, "required": ["op", "id", "dispatch"],
                 "properties": {"op": {"const": "dispatch"}, "id": {"$ref": "#/$defs/id"},
                                "dispatch": {"$ref": "https://jeff.dev/schemas/decide_request.schema.json#/$defs/dispatch"},
                                "on_low_confidence": {"$ref": "https://jeff.dev/schemas/decide_request.schema.json#/$defs/policy"}}},
    "graph": {"type": "object", "additionalProperties": false, "required": ["op", "id", "graph", "input", "params"],
              "properties": {"op": {"const": "graph"}, "id": {"$ref": "#/$defs/id"},
                             "graph": {"$ref": "https://jeff.dev/schemas/decide_request.schema.json#/$defs/graph"},
                             "input": true,
                             "params": {"type": "object"},
                             "on_low_confidence_by_node": {"type": "object", "maxProperties": 256,
                                                           "additionalProperties": {"$ref": "https://jeff.dev/schemas/decide_request.schema.json#/$defs/policy"}}}}
  },
  "oneOf": [
    {"$ref": "#/$defs/hello"},
    {"$ref": "#/$defs/engine_hello"},
    {"$ref": "#/$defs/simple"},
    {"$ref": "#/$defs/predict"},
    {"$ref": "#/$defs/serve"},
    {"$ref": "#/$defs/auth"},
    {"$ref": "#/$defs/bind"},
    {"$ref": "#/$defs/call"},
    {"$ref": "#/$defs/call_many"},
    {"$ref": "#/$defs/release"},
    {"$ref": "#/$defs/decide"},
    {"$ref": "#/$defs/dispatch"},
    {"$ref": "#/$defs/graph"},
    {"$ref": "#/$defs/ok_reply"},
    {"$ref": "#/$defs/failure_reply"}
  ]
}
