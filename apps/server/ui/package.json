{
  "name": "jeff-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The Jeff web console, served by apps/server at /ui; built into apps/server/src/jeff_server/ui.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@jeff/brand": "workspace:*",
    "@jeff/ui": "workspace:*",
    "lucide-react": "0.554.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
